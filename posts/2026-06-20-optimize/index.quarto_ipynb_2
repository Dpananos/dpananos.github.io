      "source": [
        "#| fig-cap: Zero-optimization fit of a Student-$t_3$ target using a 100-component basis derived via Gauss-Laguerre Quadrature.\n",
        "\n",
        "from scipy.special import roots_genlaguerre, gamma\n",
        "\n",
        "\n",
        "s = 0.05\n",
        "nu = 3.0\n",
        "h_dist = t(df=nu, loc=0, scale=s)\n",
        "K_quad = 100\n",
        "\n",
        "# 1. Derive Optimal Basis analytically\n",
        "alpha = nu / 2.0\n",
        "beta_param = nu * (s**2) / 2.0\n",
        "gamma_param = alpha - 1.0\n",
        "\n",
        "# Extract nodes (z_k) and weights (w_k)\n",
        "nodes, weights = roots_genlaguerre(K_quad, gamma_param)\n",
        "\n",
        "# Convert nodes to optimal standard deviations and weights to mixture probabilities\n",
        "taus_smart = np.sqrt(beta_param / nodes)\n",
        "pis_smart = weights / gamma(alpha)\n",
        "\n",
        "# 2. Evaluate\n",
        "theta, h, lo, hi = evaluation_mesh(h_dist)\n",
        "A_smart = design_matrix(theta, np.zeros(len(taus_smart)), taus_smart)\n",
        "g_smart = A_smart @ pis_smart\n",
