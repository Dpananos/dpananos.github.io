        "#| include: false\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.optimize import minimize\n",
        "from scipy.stats import norm, skewnorm, t\n",
        "from qpsolvers import solve_qp\n",
        "\n",
        "ALPHA = 1e-4\n",
        "N_GRID = 2000\n",
        "N_SCALES = 25\n",
        "\n",
        "\n",
        "def design_matrix(theta, mu, tau):\n",
        "    return norm.pdf(theta[:, np.newaxis], loc=mu, scale=tau)\n",
        "\n",
        "\n",
        "def mixture_density(theta, pi, mu, tau):\n",
        "    return design_matrix(theta, mu, tau) @ pi\n",
        "\n",
        "\n",
        "def solve_mixture(A, hg, ridge_penalty=1e-8):\n",
        "    n_components = A.shape[1]\n",
        "    D0 = A.T @ A\n",
        "    P = 2 * (D0 + ridge_penalty * np.mean(np.diag(D0)) * np.eye(n_components))\n",
        "    q = -2 * (A.T @ hg)\n",
        "    C = np.ones((1, n_components))\n",
        "    b = np.array([1.0])\n",
        "    G = -np.eye(n_components)\n",
        "    return solve_qp(P, q, G, np.zeros(n_components), C, b, solver=\"cvxopt\")\n",
        "\n",
        "\n",
        "def evaluation_mesh(h_dist, alpha=ALPHA, n_grid=N_GRID):\n",
        "    lo = h_dist.ppf(alpha)\n",
        "    hi = h_dist.ppf(1 - alpha)\n",
        "    theta = np.linspace(lo, hi, n_grid)\n",
        "    h = h_dist.pdf(theta)\n",
        "    return theta, h, lo, hi\n",
        "\n",
        "\n",
        "def scale_grid(s, n_scales=N_SCALES):\n",
        "    return np.exp(np.linspace(np.log(s * 0.04), np.log(s * 30), n_scales))\n",
        "\n",
        "\n",
        "def dictionary_grid(means, scales):\n",
        "    mus = np.repeat(means, len(scales))\n",
        "    taus = np.tile(scales, len(means))\n",
        "    return mus, taus\n",
        "\n",
        "\n",
        "def plot_density_fit(ax, theta, h, g):\n",
        "    ax.plot(theta, np.log(h), lw=2, label=\"$h(\\\\theta)$\")\n",
        "    ax.plot(theta, np.log(g), alpha=0.5, lw=4, label=\"mixture approx.\")\n",
        "    ax.set_xlabel(\"$\\\\theta$\")\n",
        "    ax.set_ylabel(\"Log Probability Density\")\n",
        "    ax.legend()\n",
        "\n",
        "\n",
        "def _unpack_joint_params(params, k):\n",
        "    return params[:k], params[k : 2 * k], params[2 * k : 3 * k]\n",
        "\n",
        "\n",
        "def joint_objective(params, theta, h, k):\n",
        "    pi, mu, tau = _unpack_joint_params(params, k)\n",
        "    residual = mixture_density(theta, pi, mu, tau) - h\n",
        "    return 0.5 * np.sum(residual**2)\n",
        "\n",
        "\n",
        "def joint_jacobian(params, theta, h, k):\n",
        "    pi, mu, tau = _unpack_joint_params(params, k)\n",
        "    fit = np.zeros_like(theta)\n",
        "    pdfs = np.zeros((k, len(theta)))\n",
        "\n",
        "    for idx in range(k):\n",
        "        pdfs[idx] = norm.pdf(theta, loc=mu[idx], scale=tau[idx])\n",
        "        fit += pi[idx] * pdfs[idx]\n",
        "\n",
        "    residual = fit - h\n",
        "    grad_pi = np.zeros(k)\n",
        "    grad_mu = np.zeros(k)\n",
        "    grad_tau = np.zeros(k)\n",
        "\n",
        "    for idx in range(k):\n",
        "        grad_pi[idx] = np.sum(residual * pdfs[idx])\n",
        "        dphi_dmu = pdfs[idx] * (theta - mu[idx]) / tau[idx] ** 2\n",
        "        grad_mu[idx] = np.sum(residual * pi[idx] * dphi_dmu)\n",
        "        dphi_dtau = pdfs[idx] * (((theta - mu[idx]) ** 2 / tau[idx] ** 3) - (1.0 / tau[idx]))\n",
        "        grad_tau[idx] = np.sum(residual * pi[idx] * dphi_dtau)\n",
        "\n",
        "    return np.concatenate([grad_pi, grad_mu, grad_tau])\n",
        "\n",
        "\n",
        "def initial_joint_params(k, s, h_dist):\n",
        "    pi = np.ones(k) / k\n",
        "    probs = np.linspace(ALPHA, 1 - ALPHA * 10, k)\n",
        "    mu = h_dist.ppf(probs)\n",
        "    tau = np.geomspace(s * 0.04, s * 30, k)\n",
        "    return np.concatenate([pi, mu, tau])\n",
        "\n",
        "\n",
        "def _joint_bounds(k, lo, hi, s):\n",
        "    return [(0.0, 1.0)] * k + [(lo, hi)] * k + [(s * 0.04, s * 30)] * k\n",
        "\n",
        "\n",
        "def _clip_joint_params(params, bounds, k):\n",
        "    clipped = params.copy()\n",
        "    for idx, (lower, upper) in enumerate(bounds):\n",
        "        clipped[idx] = np.clip(clipped[idx], lower, upper)\n",
        "    clipped[:k] = np.maximum(clipped[:k], 0.0)\n",
        "    clipped[:k] /= clipped[:k].sum()\n",
        "    return clipped\n",
        "\n",
        "\n",
        "def _run_joint_optimize(x0, theta, h, k, bounds):\n",
        "    constraints = {\n",
        "        \"type\": \"eq\",\n",
        "        \"fun\": lambda p, kk=k: np.sum(p[:kk]) - 1.0,\n",
        "        \"jac\": lambda p, kk=k: np.concatenate([np.ones(kk), np.zeros(2 * kk)]),\n",
        "    }\n",
        "    return minimize(\n",
        "        joint_objective,\n",
        "        x0,\n",
        "        args=(theta, h, k),\n",
        "        jac=lambda p, t=theta, hg=h, kk=k: joint_jacobian(p, t, hg, kk),\n",
        "        bounds=bounds,\n",
        "        constraints=constraints,\n",
        "        method=\"SLSQP\",\n",
        "        options={\"ftol\": 1e-9, \"maxiter\": 5000, \"disp\": False},\n",
        "    )\n",
        "\n",
        "\n",
        "def fit_mixture_joint(theta, h, k, lo, hi, s, h_dist, n_starts=25, seed=0):\n",
        "    bounds = _joint_bounds(k, lo, hi, s)\n",
        "    x0 = _clip_joint_params(initial_joint_params(k, s, h_dist), bounds, k)\n",
        "    rng = np.random.default_rng(seed)\n",
        "    starts = [x0]\n",
        "\n",
        "    for _ in range(n_starts - 1):\n",
        "        x = x0.copy()\n",
        "        x[k : 2 * k] += rng.normal(0.0, 0.002, k)\n",
        "        x[2 * k : 3 * k] *= rng.lognormal(0.0, 0.2, k)\n",
        "        starts.append(_clip_joint_params(x, bounds, k))\n",
        "\n",
        "    best = None\n",
        "    for x_start in starts:\n",
        "        result = _run_joint_optimize(x_start, theta, h, k, bounds)\n",
        "        if best is None or result.fun < best.fun:\n",
        "            best = result\n",
        "\n",
        "    pi, mu, tau = _unpack_joint_params(best.x, k)\n",
        "    return pi, mu, tau, mixture_density(theta, pi, mu, tau)\n",
        "\n",
        "\n",
        "def _unpack_zero_mean_params(params, k):\n",
        "    return params[:k], params[k : 2 * k]\n",
        "\n",
        "\n",
        "def zero_mean_objective(params, theta, h, k):\n",
        "    pi, tau = _unpack_zero_mean_params(params, k)\n",
        "    residual = mixture_density(theta, pi, np.zeros(k), tau) - h\n",
        "    return 0.5 * np.sum(residual**2)\n",
        "\n",
        "\n",
        "def zero_mean_jacobian(params, theta, h, k):\n",
        "    pi, tau = _unpack_zero_mean_params(params, k)\n",
        "    mu = np.zeros(k)\n",
        "    fit = np.zeros_like(theta)\n",
        "    pdfs = np.zeros((k, len(theta)))\n",
        "\n",
        "    for idx in range(k):\n",
        "        pdfs[idx] = norm.pdf(theta, loc=mu[idx], scale=tau[idx])\n",
        "        fit += pi[idx] * pdfs[idx]\n",
        "\n",
        "    residual = fit - h\n",
        "    grad_pi = np.zeros(k)\n",
        "    grad_tau = np.zeros(k)\n",
        "\n",
        "    for idx in range(k):\n",
        "        grad_pi[idx] = np.sum(residual * pdfs[idx])\n",
        "        dphi_dtau = pdfs[idx] * ((theta**2 / tau[idx] ** 3) - (1.0 / tau[idx]))\n",
        "        grad_tau[idx] = np.sum(residual * pi[idx] * dphi_dtau)\n",
        "\n",
        "    return np.concatenate([grad_pi, grad_tau])\n",
        "\n",
        "\n",
        "def initial_zero_mean_params(k, s):\n",
        "    pi = np.ones(k) / k\n",
        "    tau = np.geomspace(s * 0.04, s * 30, k)\n",
        "    return np.concatenate([pi, tau])\n",
        "\n",
        "\n",
        "def _zero_mean_bounds(k, s):\n",
        "    return [(0.0, 1.0)] * k + [(s * 0.04, s * 30)] * k\n",
        "\n",
        "\n",
        "def _clip_zero_mean_params(params, bounds, k):\n",
        "    clipped = params.copy()\n",
        "    for idx, (lower, upper) in enumerate(bounds):\n",
        "        clipped[idx] = np.clip(clipped[idx], lower, upper)\n",
        "    clipped[:k] = np.maximum(clipped[:k], 0.0)\n",
        "    clipped[:k] /= clipped[:k].sum()\n",
        "    return clipped\n",
        "\n",
        "\n",
        "def _run_zero_mean_optimize(x0, theta, h, k, bounds):\n",
        "    constraints = {\n",
        "        \"type\": \"eq\",\n",
        "        \"fun\": lambda p, kk=k: np.sum(p[:kk]) - 1.0,\n",
        "        \"jac\": lambda p, kk=k: np.concatenate([np.ones(kk), np.zeros(kk)]),\n",
        "    }\n",
        "    return minimize(\n",
        "        zero_mean_objective,\n",
        "        x0,\n",
        "        args=(theta, h, k),\n",
        "        jac=lambda p, t=theta, hg=h, kk=k: zero_mean_jacobian(p, t, hg, kk),\n",
        "        bounds=bounds,\n",
        "        constraints=constraints,\n",
        "        method=\"SLSQP\",\n",
        "        options={\"ftol\": 1e-9, \"maxiter\": 5000, \"disp\": False},\n",
        "    )\n",
        "\n",
        "\n",
        "def fit_mixture_joint_zero_mean(theta, h, k, s, n_starts=25, seed=0):\n",
        "    bounds = _zero_mean_bounds(k, s)\n",
        "    x0 = _clip_zero_mean_params(initial_zero_mean_params(k, s), bounds, k)\n",
        "    rng = np.random.default_rng(seed)\n",
        "    starts = [x0]\n",
        "\n",
        "    for _ in range(n_starts - 1):\n",
        "        x = x0.copy()\n",
        "        x[k : 2 * k] *= rng.lognormal(0.0, 0.2, k)\n",
        "        starts.append(_clip_zero_mean_params(x, bounds, k))\n",
        "\n",
        "    best = None\n",
        "    for x_start in starts:\n",
        "        result = _run_zero_mean_optimize(x_start, theta, h, k, bounds)\n",
        "        if best is None or result.fun < best.fun:\n",
        "            best = result\n",
        "\n",
        "    pi, tau = _unpack_zero_mean_params(best.x, k)\n",
        "    mu = np.zeros(k)\n",
        "    return pi, mu, tau, mixture_density(theta, pi, mu, tau)"
