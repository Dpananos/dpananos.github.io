        "#| fig-cap: Convex QP fit of a Student-$t_3$ target with a Gaussian mixture basis centered at zero.\n",
        "\n",
        "s = 0.05\n",
        "h_dist = t(df=3, loc=0, scale=s)\n",
        "\n",
        "theta, h, lo, hi = evaluation_mesh(h_dist)\n",
        "scales = scale_grid(s)\n",
        "A = design_matrix(theta, np.zeros(len(scales)), scales)\n",
        "\n",
        "pi = solve_mixture(A, h)\n",
