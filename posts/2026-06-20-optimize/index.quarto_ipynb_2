        "\n",
        "plot_density_fit(axes[0], theta, h, g_smart)\n",
        "\n",
        "axes[1].stem(np.log(taus_smart), pis_smart, basefmt=\" \")\n",
        "axes[1].set_xlabel(\"$\\\\log \\\\tau$ (Analytically Selected)\")\n",
        "axes[1].set_ylabel(\"$\\\\pi_k$ (Analytically Selected)\")\n",
        "\n",
        "plt.show()"
